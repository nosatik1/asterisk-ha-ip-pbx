MASTER                
rrp_instance VI_1 {
    state MASTER                
    interface enp0s8            
    virtual_router_id 51        
    priority 100                
    advert_int 1                
    
    authentication {
        auth_type PASS          
        auth_pass 1             
    }
    
    virtual_ipaddress {
        192.168.1.1/24          
    }
}

BACKUP                
vrrp_instance VI_1 {
    state BACKUP                
    interface enp0s8
    virtual_router_id 51
    priority 90            
    advert_int 1
    
    authentication {
        auth_type PASS
        auth_pass 1
    }
    virtual_ipaddress {
        192.168.1.1/24
    }
}
